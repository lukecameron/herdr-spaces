# Herdr Spaces settings. Copy this file to the directory printed by
#   herdr plugin config-dir lukecameron.spaces
# as config.env. Every setting is optional; the values below are the defaults.
# The plugin reads the file once at startup.

# How often the session is read.
#HERDR_SPACES_POLL=2s

# Report model-generated space names. Set to false to keep only the counts.
#HERDR_SPACES_NAMING=true

# How often eligible spaces are considered for a new name.
#HERDR_SPACES_NAMING_INTERVAL=10m

# Wait this long after startup before the first naming pass.
#HERDR_SPACES_NAMING_DELAY=30s

# Model passed to `claude --model`.
#HERDR_SPACES_MODEL=haiku

# The Claude Code binary.
#HERDR_SPACES_CLAUDE_BIN=claude

# Log the names the model proposes without renaming anything.
#HERDR_SPACES_DRY_RUN=false

# Log at DEBUG rather than INFO.
#HERDR_SPACES_DEBUG=false
